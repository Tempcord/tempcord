{
    "name": "tempcord/tempcord",
    "description": "A modern Discord bot framework for PHP built on top of Tempest",
    "type": "project",
    "keywords": [
        "discord",
        "bot",
        "framework",
        "php",
        "tempest",
        "api"
    ],
    "homepage": "https://github.com/tempcord/tempcord",
    "license": "MIT",
    "authors": [
        {
            "name": "CyberWolf.Studio",
            "email": "hello@cyberwolf.studio",
            "homepage": "https://cyberwolf.studio",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/tempcord/tempcord/issues",
        "source": "https://github.com/tempcord/tempcord",
        "docs": "https://github.com/tempcord/framework/blob/master/docs/README.md"
    },
    "require": {
        "php": "^8.5",
        "tempcord/framework": "^0.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
